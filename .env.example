APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://sadakwatch:sadakwatch@localhost:5432/sadakwatch?sslmode=disable
STORAGE_PATH=./data/media
LOG_LEVEL=info
# Comma-separated keys accepted for ingestion; leave empty for an open dev server.
INGEST_API_KEYS=
ADMIN_API_KEY=
ADMIN_TIMEZONE=Asia/Kolkata
ROAD_MATCH_METERS=30
