<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/cameraOff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="Camera preview appears when a drive starts.\nMount the phone facing the road ahead."
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <!-- Top HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="10dp"
        android:background="@drawable/hud_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot"
                android:backgroundTint="@color/muted" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ready"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Map"
                android:textColor="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="Settings"
                android:textColor="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HudLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h" />

                <TextView
                    android:id="@+id/speedValue"
                    style="@style/HudValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="–" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HudLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS ±m" />

                <TextView
                    android:id="@+id/gpsValue"
                    style="@style/HudValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="–" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HudLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This drive" />

                <TextView
                    android:id="@+id/tripValue"
                    style="@style/HudValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HudLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To upload" />

                <TextView
                    android:id="@+id/queueValue"
                    style="@style/HudValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/hud_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/lastEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Bumps are detected automatically while driving. Tap a button to report what you see."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportPothole"
                style="@style/ReportButton"
                android:text="Pothole" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportWater"
                style="@style/ReportButton"
                android:text="Waterlogging" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportMore"
                style="@style/ReportButton"
                android:text="Other…" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/driveButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="6dp"
            android:text="@string/start_drive"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</FrameLayout>
